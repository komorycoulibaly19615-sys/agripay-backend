# ==================== DATABASE ====================
DATABASE_URL=postgresql://user:password@localhost:5432/agripay

# ==================== JWT ====================
# Génère une clé sécurisée: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-key-in-production

# ==================== SERVER ====================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ==================== CORS ====================
# Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
